{
  "manifest_version": 3,
  "name": "DON'TPANIC",
  "version": "1.0.0",
  "description": "A minimal todo list for your new tab. What's mostly harmless?",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": [
    "storage",
    "theme"
  ],
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}